<UserControl x:Class="ThatSkyAppV2.CustomDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!-- App Button Style -->
        <Style x:Key="AppButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="#FF20A1C3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF111111"/>
                        <GradientStop Color="#FF1A2026" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF0A0A0A"/>
                                <GradientStop Color="#FF151B20" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#FF1B8AA7"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF25B6DE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="#80000000">
        <Border BorderThickness="1" 
                CornerRadius="5" 
                BorderBrush="#FF20A1C3" 
                Width="400" 
                MinHeight="150"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF111111" />
                    <GradientStop Color="#FF1A2026" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5" Color="#FF20A1C3"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Icon and Message -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="AlertCircle"
                                              Width="24" 
                                              Height="24"
                                              Foreground="#FFFFD700"
                                              Margin="0,0,15,0"
                                              VerticalAlignment="Top"/>
                    <TextBlock x:Name="MessageText"
                             Grid.Column="1"
                             Text="Dialog Message"
                             Foreground="White"
                             TextWrapping="Wrap"
                             VerticalAlignment="Center"/>
                </Grid>

                <!-- Buttons -->
                <UniformGrid Grid.Row="2" 
                            Rows="1" 
                            HorizontalAlignment="Right" 
                            Margin="0,15,0,0">
                    <Button x:Name="YesButton"
                            Style="{StaticResource AppButtonStyle}"
                            Height="35"
                            Width="100"
                            Margin="0,0,10,0"
                            Click="YesButton_Click">
                        <TextBlock Text="Yes" 
                                 HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="NoButton"
                            Style="{StaticResource AppButtonStyle}"
                            Height="35"
                            Width="100"
                            Click="NoButton_Click">
                        <TextBlock Text="No" 
                                 HorizontalAlignment="Center"/>
                    </Button>
                </UniformGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>