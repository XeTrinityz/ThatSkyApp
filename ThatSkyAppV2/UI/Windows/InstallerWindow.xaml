<mah:MetroWindow x:Class="ThatSkyAppV2.UI.Windows.InstallerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="{DynamicResource Str.Window.Title}"
                 Width="720"
                 Height="375"
                 ResizeMode="NoResize"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d"
                 WindowTitleBrush="#0F172A"
                 TitleCharacterCasing="Normal"
                 TitleAlignment="Center"
                 TitleBarHeight="38"
                 Background="#0F172A"
                 NonActiveBorderBrush="#1E293B"
                 BorderThickness="0"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 BorderBrush="#1E293B"
                 NonActiveWindowTitleBrush="#0F172A"
                 GlowBrush="#00D9FF"
                 UseNoneWindowStyle="False"
                 NonActiveGlowBrush="#00D9FF">

    <mah:MetroWindow.TitleTemplate>
        <DataTemplate>
            <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=mah:MetroWindow}, Path=Title}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </DataTemplate>
    </mah:MetroWindow.TitleTemplate>

    <mah:MetroWindow.Resources>
        <!-- Modern App Button Style with Animations -->
        <Style x:Key="AppButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="#3000D9FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1E293B" Offset="0"/>
                        <GradientStop Color="#0F172A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1.5"
                                CornerRadius="12"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" 
                                                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                          To="#6000D9FF"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" 
                                                          Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                                          To="#3000D9FF"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.98"
                                                           Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.98"
                                                           Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1"
                                                           Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1"
                                                           Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Maintenance Menu Button Style -->
        <Style x:Key="MaintenanceMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" 
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="#2000D9FF"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" 
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="Transparent"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3000D9FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circle Button Style -->
        <Style x:Key="MahApps.Styles.Button.Circle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="999"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" 
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="#2000D9FF"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="border" 
                                                          Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                          To="Transparent"
                                                          Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.9"
                                                           Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.9"
                                                           Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1"
                                                           Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="scaleTransform"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1"
                                                           Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid x:Name="MainContent" MouseDown="MainContent_MouseDown" Margin="24,12,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button x:Name="InstallButton" 
                Style="{StaticResource AppButtonStyle}"
                Click="InstallButton_Click"
                Margin="0,0,0,8"
                Width="Auto">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="Download" 
                        Width="20" Height="20"
                        Foreground="#00D9FF"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"/>
                    <TextBlock x:Name="InstallButtonText" 
                        Text="{DynamicResource Str.Button.Inject}" 
                        VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Second Row Buttons -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="0,8">
                <Button x:Name="CheckForUpdatesButton"
                        Style="{StaticResource AppButtonStyle}"
                        Click="CheckForUpdatesButton_Click"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconBootstrapIcons Kind="ArrowClockwise" 
                                                        Width="20" Height="20"
                                                        Foreground="#00D9FF"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Str.Button.CheckForUpdates}" 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="ChangelogButton"
                        Style="{StaticResource AppButtonStyle}"
                        Click="ChangelogButton_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconRadixIcons Kind="ActivityLog" 
                                                    Width="20" Height="20"
                                                    Foreground="#00D9FF"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Str.Button.Changelog}" 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Third Row Buttons -->
            <UniformGrid Grid.Row="2" Rows="1" Margin="0,8">
                <Button x:Name="OpenTSMFolder"
                        Style="{StaticResource AppButtonStyle}"
                        Click="OpenTSMFolder_Click"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterialDesign Kind="DriveFolderUpload" 
                                                        Width="20" Height="20"
                                                        Foreground="#00D9FF"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Str.Button.TSMResources}" 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="LaunchSky"
                        Style="{StaticResource AppButtonStyle}"
                        Click="LaunchSky_Click"
                        Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconBootstrapIcons Kind="Steam" 
                                                        Width="20" Height="20"
                                                        Foreground="#00D9FF"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Str.Button.LaunchSky}" 
                                 VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Maintenance Menu and Action Buttons -->
            <Grid Grid.Row="3">
                <Button x:Name="MaintenanceButton"
                        Style="{StaticResource AppButtonStyle}"
                        Click="MaintenanceButton_Click"
                        Width="Auto"
                        VerticalAlignment="Top"
                        Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <iconPacks:PackIconMaterial Kind="ToolboxOutline" 
                                                  Width="20" Height="20"
                                                  Foreground="#00D9FF"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Str.Button.Maintenance}" 
                                 VerticalAlignment="Center"
                                 Margin="0,0,10,0"/>
                        <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                  Width="18" Height="18"
                                                  Foreground="#94A3B8"
                                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Popup menu for maintenance options -->
                <Popup x:Name="MaintenanceMenu" 
                       PlacementTarget="{Binding ElementName=MaintenanceButton}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False">
                    <Border Background="#1E293B" 
                            BorderBrush="#3000D9FF"
                            BorderThickness="1.5"
                            CornerRadius="12"
                            Padding="8"
                            Margin="0,8,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" 
                                            ShadowDepth="0" 
                                            Opacity="0.4" 
                                            Color="#00D9FF"/>
                        </Border.Effect>
                        <StackPanel>
                            <Button x:Name="VerifyFilesButton"
                                Style="{StaticResource MaintenanceMenuButtonStyle}"
                                Click="VerifyFilesButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="FileCheck"
                                      Width="18" Height="18"
                                      Foreground="#00D9FF"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                    <TextBlock Text="Verify Game Files"
                                      Foreground="White"
                                      FontSize="14"
                                      VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Separator Background="#2094A3B8" Margin="8,4"/>

                            <Button x:Name="InstallVCRedistButton"
                                    Style="{StaticResource MaintenanceMenuButtonStyle}"
                                    Click="InstallVCRedistButton_Click">
                                <StackPanel Orientation="Horizontal">
                                    <iconPacks:PackIconMaterial Kind="MicrosoftVisualStudio"
                                      Width="18" Height="18"
                                      Foreground="#00D9FF"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"/>
                                    <TextBlock Text="Install VC Redist"
                                      Foreground="White"
                                      FontSize="14"
                                      VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Grid>

        <!-- Popup Container -->
        <Grid x:Name="PopupContainer" 
              Panel.ZIndex="1000" 
              Visibility="Hidden"/>

        <!-- Footer Info (Bottom-Left) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="12,0,0,12"
                    Panel.ZIndex="100">
            <TextBlock x:Name="AppVersionLabel"
                       FontSize="11"
                       Foreground="#64748B"
                       VerticalAlignment="Center">
                <Run Text="v"/>
                <Run x:Name="VersionRun" Text="1.0.0"/>
            </TextBlock>
            <Border Width="4" Height="4"
                    Background="#00D9FF"
                    CornerRadius="2"
                    Margin="10,0"
                    VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusLabel"
                       FontSize="11"
                       Foreground="#64748B"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Settings and About Buttons (Bottom-Right Corner) -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Bottom" 
                    Margin="0,0,12,12"
                    Panel.ZIndex="100">
            <Button x:Name="SettingsButton"
                    Click="SettingsButton_Click"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Background="#1E293B"
                    BorderBrush="#3000D9FF"
                    BorderThickness="1"
                    Width="28"
                    Height="28"
                    Margin="0,0,6,0"
                    ToolTip="Settings">
                <iconPacks:PackIconMaterial x:Name="SettingsIcon"
                                           Kind="Cog"
                                           Width="14" Height="14"
                                           Foreground="White"/>
            </Button>

            <Button x:Name="AboutButton"
                    Click="AboutButton_Click"
                    Style="{StaticResource MahApps.Styles.Button.Circle}"
                    Background="#1E293B"
                    BorderBrush="#3000D9FF"
                    BorderThickness="1"
                    Width="28"
                    Height="28"
                    ToolTip="About">
                <iconPacks:PackIconMaterial x:Name="AboutIcon"
                                           Kind="InformationOutline"
                                           Width="14" Height="14"
                                           Foreground="White"/>
            </Button>
        </StackPanel>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingRing" 
              Visibility="Hidden" 
              Background="#C00F172A">
            <Border Background="#1E293B"
                    BorderBrush="#3000D9FF"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="32,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" 
                                    ShadowDepth="0" 
                                    Opacity="0.5" 
                                    Color="#00D9FF"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <mah:ProgressRing Foreground="#00D9FF"
                                    Width="48"
                                    Height="48"/>
                    <Label x:Name="InfoLabel" 
                           Content=""
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Medium"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>