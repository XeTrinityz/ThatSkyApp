<mah:MetroWindow x:Class="ThatSkyAppV2.UI.Windows.InstallerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 Title="{DynamicResource Str.Window.Title}"
                 Width="656"
                 Height="291"
                 ResizeMode="NoResize"
                 ShowMinButton="False"
                 ShowMaxRestoreButton="False"
                 mc:Ignorable="d"
                 WindowTitleBrush="#FF1A2026"
                 TitleCharacterCasing="Normal"
                 TitleAlignment="Center"
                 TitleBarHeight="30"
                 Background="#FF111111"
                 NonActiveBorderBrush="#FF1A2024"
                 BorderThickness="3"
                 VerticalContentAlignment="Center"
                 HorizontalContentAlignment="Center"
                 BorderBrush="#FF1A2026"
                 NonActiveWindowTitleBrush="#FF1A2026">

    <mah:MetroWindow.Resources>
        <!-- Status Label Style -->
        <Style x:Key="StatusLabelStyle" TargetType="Label">
            <Setter Property="Background" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="1,5,1,5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- App Button Style -->
        <Style x:Key="AppButtonStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="#FF20A1C3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="43"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF111111"/>
                        <GradientStop Color="#FF1A2026" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                <GradientStop Color="#FF0A0A0A"/>
                                <GradientStop Color="#FF151B20" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#FF1B8AA7"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF25B6DE"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Maintenance Menu Button Style -->
        <Style x:Key="MaintenanceMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Left" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circle Button Style -->
        <Style x:Key="MahApps.Styles.Button.Circle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="999"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#30FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mah:MetroWindow.Resources>

    <Grid>
        <Grid x:Name="MainContent" MouseDown="MainContent_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <Button x:Name="InstallButton" 
                Style="{StaticResource AppButtonStyle}"
                Click="InstallButton_Click"
                Margin="15,9,15,5"
                Width="Auto">
                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                    <iconPacks:PackIconMaterial Kind="Download" 
                        Width="16" Height="16"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        Opacity="0"/>
                    <TextBlock x:Name="InstallButtonText" 
                        Text="{DynamicResource Str.Button.Inject}" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                    <iconPacks:PackIconMaterial Kind="Download" 
                        Width="16" Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0"/>
                </Grid>
            </Button>

            <!-- Second Row Buttons -->
            <UniformGrid Grid.Row="1" Rows="1" Margin="15,5">
                <Button x:Name="CheckForUpdatesButton"
                        Style="{StaticResource AppButtonStyle}"
                        Click="CheckForUpdatesButton_Click"
                        Margin="0,0,5,0">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                        <iconPacks:PackIconBootstrapIcons Kind="ArrowClockwise" 
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="20,0,0,0"
                                                        Opacity="0"/>
                        <TextBlock Text="{DynamicResource Str.Button.CheckForUpdates}" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <iconPacks:PackIconBootstrapIcons Kind="ArrowClockwise"
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,20,0"/>
                    </Grid>
                </Button>

                <Button x:Name="ChangelogButton"
                        Style="{StaticResource AppButtonStyle}"
                        Click="ChangelogButton_Click"
                        Margin="5,0,0,0">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                        <iconPacks:PackIconRadixIcons Kind="ActivityLog" 
                                                    Width="16" Height="16"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    Margin="20,0,0,0"
                                                    Opacity="0"/>
                        <TextBlock Text="{DynamicResource Str.Button.Changelog}" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <iconPacks:PackIconRadixIcons Kind="ActivityLog"
                                                    Width="16" Height="16"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,20,0"/>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Third Row Buttons -->
            <UniformGrid Grid.Row="2" Rows="1" Margin="15,5">
                <Button x:Name="OpenTSMFolder"
                        Style="{StaticResource AppButtonStyle}"
                        Click="OpenTSMFolder_Click"
                        Margin="0,0,5,0">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                        <iconPacks:PackIconMaterialDesign Kind="DriveFolderUpload" 
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="20,0,0,0"
                                                        Opacity="0"/>
                        <TextBlock Text="{DynamicResource Str.Button.TSMResources}" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <iconPacks:PackIconMaterialDesign Kind="DriveFolderUpload"
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,20,0"/>
                    </Grid>
                </Button>

                <Button x:Name="LaunchSky"
                        Style="{StaticResource AppButtonStyle}"
                        Click="LaunchSky_Click"
                        Margin="5,0,0,0">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                        <iconPacks:PackIconBootstrapIcons Kind="Steam" 
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="20,0,0,0"
                                                        Opacity="0"/>
                        <TextBlock Text="{DynamicResource Str.Button.LaunchSky}" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <iconPacks:PackIconBootstrapIcons Kind="Steam"
                                                        Width="16" Height="16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,20,0"/>
                    </Grid>
                </Button>
            </UniformGrid>

            <!-- Maintenance Menu -->
            <Grid Grid.Row="3" Margin="15,0,15,5">
                <Button x:Name="MaintenanceButton"
                        Style="{StaticResource AppButtonStyle}"
                        Click="MaintenanceButton_Click"
                        Width="Auto">
                    <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Button}}">
                        <iconPacks:PackIconMaterial Kind="ToolboxOutline" 
                                                  Width="16" Height="16"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Margin="20,0,0,0"
                                                  Opacity="0"/>
                        <TextBlock Text="{DynamicResource Str.Button.Maintenance}" 
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <iconPacks:PackIconMaterial Kind="ChevronDown"
                                                  Width="16" Height="16"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,20,0"/>
                    </Grid>
                </Button>

                <!-- Popup menu for maintenance options -->
                <Popup x:Name="MaintenanceMenu" 
                       PlacementTarget="{Binding ElementName=MaintenanceButton}"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       StaysOpen="False">
                    <Border Background="#FF1A2026" 
                            BorderBrush="#FF20A1C3"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="0,5,0,0">
                        <StackPanel>
                            <Button x:Name="VerifyFilesButton"
                                Style="{StaticResource MaintenanceMenuButtonStyle}"
                                Click="VerifyFilesButton_Click">
                                <Grid Width="200">
                                    <iconPacks:PackIconMaterial Kind="FileCheck"
                                  Width="16" Height="16"
                                  HorizontalAlignment="Left"
                                  Margin="15,0,0,0"/>
                                    <TextBlock Text="Verify Game Files"
                                      Foreground="White"
                                      HorizontalAlignment="Left"
                                      Margin="45,0,0,0"/>
                                </Grid>
                            </Button>

                            <Separator Background="#30FFFFFF" Margin="10,0"/>

                            <Button x:Name="InstallVCRedistButton"
                                    Style="{StaticResource MaintenanceMenuButtonStyle}"
                                    Click="InstallVCRedistButton_Click">
                                <Grid Width="200">
                                    <iconPacks:PackIconMaterial Kind="MicrosoftVisualStudio"
                                      Width="16" Height="16"
                                      HorizontalAlignment="Left"
                                      Margin="15,0,0,0"/>
                                    <TextBlock Text="Install VC Redist"
                                      Foreground="White"
                                      HorizontalAlignment="Left"
                                      Margin="45,0,0,0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>

            <!-- Status Bar (labels removed, buttons retained) -->
            <Grid Grid.Row="4" Background="#FF1A2026">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Margin="5,0"/>

                <Button x:Name="SettingsButton"
        Grid.Column="1"
        Click="SettingsButton_Click"
        Width="30" Height="30"
        Style="{StaticResource MahApps.Styles.Button.Circle}"
        Background="Transparent"
        BorderBrush="Transparent"
        Margin="0,0,5,0">
                    <iconPacks:PackIconMaterial Kind="Cog"
                               Width="12" Height="12"/>
                </Button>

                <Button x:Name="AboutButton"
        Grid.Column="2"
        Click="AboutButton_Click"
        Width="30" Height="30"
        Style="{StaticResource MahApps.Styles.Button.Circle}"
        Background="Transparent"
        BorderBrush="Transparent">
                    <iconPacks:PackIconMaterialDesign Kind="QuestionMark"
                                    Width="12" Height="12"/>
                </Button>
            </Grid>

            <!-- Popup Container -->
            <Grid x:Name="PopupContainer" 
                  Panel.ZIndex="1000" 
                  Visibility="Hidden"
                  Grid.RowSpan="5"/>
        </Grid>

        <!-- Loading Overlay -->
        <Grid x:Name="LoadingRing" 
              Visibility="Hidden" 
              Background="#80000000">
            <StackPanel HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                <mah:ProgressRing Foreground="#FF20A1C3"/>
                <Label x:Name="InfoLabel" 
                       Content=""
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</mah:MetroWindow>