    <system:String x:Key="Str.Error.GameDidNotStart">Sky.exe did not start within the expected time.</system:String>
    <system:String x:Key="Str.Error.TSMNotFound">TSM.dll not found after extraction</system:String>
    <system:String x:Key="Str.Error.InjectionFailed">Injection failed.</system:String>
    <system:String x:Key="Str.Error.DownloadTSMFailed">Failed to download TSM.zip</system:String>
    <system:String x:Key="Str.Error.DownloadVCRedistFailed">Failed to download VC Redist</system:String>
    <system:String x:Key="Str.Error.CannotDetermineExePath">Cannot determine current executable path</system:String>

