    <system:String x:Key="Str.Settings.Misc.Header">Miscellaneous</system:String>
    <system:String x:Key="Str.Settings.Misc.DownloadLatest">Download latest on inject (recommended)</system:String>
    <system:String x:Key="Str.Settings.Misc.AutoLaunchGame">Auto-launch game when injecting</system:String>
    <system:String x:Key="Str.Settings.Misc.InjectDelayMs">Inject Delay (ms)</system:String>

    <!-- Dialogs -->
    <system:String x:Key="Str.Dialog.SelectBaseFolder">Select a base folder for the mod installation</system:String>
    <system:String x:Key="Str.Dialog.SelectSkyInstallFolder">Select mod installation folder</system:String>

    <!-- Status (InstallationService) -->
    <system:String x:Key="Str.Status.GameAlreadyRunning">Game is already running, injecting directly...</system:String>
    <system:String x:Key="Str.Status.DownloadingTSM">Downloading TSM.zip...</system:String>
    <system:String x:Key="Str.Status.DownloadingTSMProgress">Downloading TSM.zip: {0:F1}% ({1:F1} MB/s)</system:String>
    <system:String x:Key="Str.Status.ExtractingTSM">Extracting TSM.zip...</system:String>
    <system:String x:Key="Str.Status.UsingLocalTSM">Using local TSM files...</system:String>
    <system:String x:Key="Str.Status.LaunchingGame">Launching game...</system:String>
    <system:String x:Key="Str.Status.WaitingForGame">Waiting for game process...</system:String>
    <system:String x:Key="Str.Status.InjectingTSM">Injecting TSM.dll...</system:String>
    <system:String x:Key="Str.Status.WaitingBeforeInjection">Waiting {0} ms before injection...</system:String>
    <system:String x:Key="Str.Status.DownloadingVCRedistProgress">Downloading VC Redist: {0:F1}% ({1:F1} MB/s)</system:String>

    <!-- Update messages -->
    <system:String x:Key="Str.Update.MessageWithUpdate">That Sky Mod V{0} | That Sky App: Update Available (V{1})</system:String>
    <system:String x:Key="Str.Update.MessageNoUpdate">That Sky Mod V{0} | That Sky App V{1}</system:String>

    <!-- Common -->
    <system:String x:Key="Str.Common.ErrorTitle">Error</system:String>

    <!-- About Window -->
    <system:String x:Key="Str.About.AppName">That Sky App</system:String>
    <system:String x:Key="Str.About.Version">Version {0}</system:String>
    <system:String x:Key="Str.About.CreatedBy">Created by XeTrinityz</system:String>
    <system:String x:Key="Str.About.Discord">Discord Community</system:String>
    <system:String x:Key="Str.About.ViewOnGitHub">View on GitHub</system:String>
</ResourceDictionary>