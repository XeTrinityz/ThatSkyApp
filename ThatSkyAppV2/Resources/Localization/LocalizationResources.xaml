    <system:String x:Key="Str.Button.Maintenance">Maintenance</system:String>
    <system:String x:Key="Str.Button.Save">Save</system:String>
    <system:String x:Key="Str.Button.Inject">Inject</system:String>

    <!-- Menu Items -->
    <system:String x:Key="Str.Menu.RepairInstallation">Repair Installation</system:String>
    <system:String x:Key="Str.Menu.InstallVCRedist">Install VC Redist</system:String>
    <system:String x:Key="Str.Menu.UninstallTSM">Uninstall TSM</system:String>
    <system:String x:Key="Str.Menu.VerifyFiles">Verify Game Files</system:String>

    <!-- Messages -->
    <system:String x:Key="Str.Message.UpdateAvailable">There is a new version of That Sky App available. Would you like to install it now?</system:String>
    <system:String x:Key="Str.Message.UpdateSuccess">TSM updated successfully</system:String>
    <system:String x:Key="Str.Message.InstallSuccess">TSM injected successfully</system:String>
    <system:String x:Key="Str.Message.UninstallSuccess">TSM uninstalled successfully</system:String>
    <system:String x:Key="Str.Message.DownloadingVCRedist">Downloading VC Redist...</system:String>
    <system:String x:Key="Str.Message.InstallingVCRedist">Installing VC Redist...</system:String>
    <system:String x:Key="Str.Message.VCRedistSuccess">VC Redist installed successfully</system:String>
    <system:String x:Key="Str.Message.VCRedistFailed">VC Redist installation failed (Error: {0})</system:String>
    <system:String x:Key="Str.Message.VCRedistCancelled">VC Redist installation cancelled by user</system:String>
    <system:String x:Key="Str.Message.CheckingUpdates">Checking for updates...</system:String>
    <system:String x:Key="Str.Message.DownloadFailed">Download failed: {0}</system:String>
    <system:String x:Key="Str.Message.UpdateFailed">Update failed: {0}</system:String>
    <system:String x:Key="Str.Message.InstallFailed">Installation failed: {0}</system:String>
    <system:String x:Key="Str.Message.UninstallFailed">Uninstall failed: {0}</system:String>
