<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Window Title -->
    <system:String x:Key="Str.Window.Title">That Sky App</system:String>

    <!-- Button Labels -->
    <system:String x:Key="Str.Button.Install">Install</system:String>
    <system:String x:Key="Str.Button.Update">Update</system:String>
    <system:String x:Key="Str.Button.CheckForUpdates">Check For Updates</system:String>
    <system:String x:Key="Str.Button.Changelog">Changelog</system:String>
    <system:String x:Key="Str.Button.TSMResources">TSM Resources</system:String>
    <system:String x:Key="Str.Button.LaunchSky">Launch Sky</system:String>
    <system:String x:Key="Str.Button.Maintenance">Maintenance</system:String>
    <system:String x:Key="Str.Button.Save">Save</system:String>

    <!-- Menu Items -->
    <system:String x:Key="Str.Menu.RepairInstallation">Repair Installation</system:String>
    <system:String x:Key="Str.Menu.InstallVCRedist">Install VC Redist</system:String>
    <system:String x:Key="Str.Menu.UninstallTSM">Uninstall TSM</system:String>
    <system:String x:Key="Str.Menu.VerifyFiles">Verify Game Files</system:String>

    <!-- Status Labels -->
    <system:String x:Key="Str.Status.TSM">TSM:</system:String>
    <system:String x:Key="Str.Status.SML">SML:</system:String>
    <system:String x:Key="Str.Status.VCRedist">VC Redist:</system:String>
    <system:String x:Key="Str.Status.Installed">Installed</system:String>
    <system:String x:Key="Str.Status.NotInstalled">Not Installed</system:String>

    <!-- Messages -->
    <system:String x:Key="Str.Message.UninstallConfirm">Uninstall TSM? All files except Sky-related content will be removed. This includes all your TSM Resources (Outfits, Local Accounts...).</system:String>
    <system:String x:Key="Str.Message.GameFolderNotFound">Game folder not found. Please select it manually.</system:String>
    <system:String x:Key="Str.Message.UpdateAvailable">There is a new version of That Sky App available. Would you like to install it now?</system:String>
    <system:String x:Key="Str.Message.UpdateSuccess">TSM updated successfully</system:String>
    <system:String x:Key="Str.Message.InstallSuccess">TSM installed successfully</system:String>
    <system:String x:Key="Str.Message.UninstallSuccess">TSM uninstalled successfully</system:String>
    <system:String x:Key="Str.Message.DownloadingVCRedist">Downloading VC Redist...</system:String>
    <system:String x:Key="Str.Message.InstallingVCRedist">Installing VC Redist...</system:String>
    <system:String x:Key="Str.Message.VCRedistSuccess">VC Redist installed successfully</system:String>
    <system:String x:Key="Str.Message.VCRedistFailed">VC Redist installation failed (Error: {0})</system:String>
    <system:String x:Key="Str.Message.VCRedistCancelled">VC Redist installation cancelled by user</system:String>
    <system:String x:Key="Str.Message.CheckingUpdates">Checking for updates...</system:String>
    <system:String x:Key="Str.Message.DownloadFailed">Download failed: {0}</system:String>
    <system:String x:Key="Str.Message.UpdateFailed">Update failed: {0}</system:String>
    <system:String x:Key="Str.Message.InstallFailed">Installation failed: {0}</system:String>
    <system:String x:Key="Str.Message.UninstallFailed">Uninstall failed: {0}</system:String>
    <system:String x:Key="Str.Message.VerifyFirst">Would you like to verify game files through Steam first?</system:String>
    <system:String x:Key="Str.Message.WaitForSteam">Please wait for Steam to finish verifying files, then click Yes to continue with TSM repair.</system:String>
    <system:String x:Key="Str.Message.VerificationStarted">Steam file verification started</system:String>

    <!-- Settings -->
    <system:String x:Key="Str.Settings.Title">Settings</system:String>
    <system:String x:Key="Str.Settings.Language">Language</system:String>
    <system:String x:Key="Str.Settings.Save">Save</system:String>
    <system:String x:Key="Str.Button.Yes">Yes</system:String>
    <system:String x:Key="Str.Button.No">No</system:String>
</ResourceDictionary>