    <system:String x:Key="Str.Settings.Title">Settings</system:String>
    <system:String x:Key="Str.Settings.Language">Language</system:String>
    <system:String x:Key="Str.Settings.Save">Save</system:String>
    <system:String x:Key="Str.Button.Yes">Yes</system:String>
    <system:String x:Key="Str.Button.No">No</system:String>
    <system:String x:Key="Str.Language.English">English</system:String>
    <system:String x:Key="Str.Language.Chinese">Chinese</system:String>
    <system:String x:Key="Str.Language.Russian">Russian</system:String>

