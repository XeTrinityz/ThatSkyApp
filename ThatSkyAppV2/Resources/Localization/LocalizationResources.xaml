<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Window Title -->
    <system:String x:Key="Str.Window.Title">That Sky App</system:String>

    <!-- Button Labels -->
    <system:String x:Key="Str.Button.Install">Install</system:String>
    <system:String x:Key="Str.Button.Update">Update</system:String>
    <system:String x:Key="Str.Button.CheckForUpdates">Check For Updates</system:String>
    <system:String x:Key="Str.Button.Changelog">Changelog</system:String>
    <system:String x:Key="Str.Button.TSMResources">TSM Resources</system:String>
