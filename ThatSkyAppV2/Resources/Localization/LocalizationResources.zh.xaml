<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!-- Window Title -->
    <system:String x:Key="Str.Window.Title">That Sky App</system:String>

    <!-- Button Labels -->
    <system:String x:Key="Str.Button.Install">安装</system:String>
    <system:String x:Key="Str.Button.Update">更新</system:String>
    <system:String x:Key="Str.Button.CheckForUpdates">检查更新</system:String>
    <system:String x:Key="Str.Button.Changelog">更新日志</system:String>
    <system:String x:Key="Str.Button.TSMResources">TSM 资源</system:String>
    <system:String x:Key="Str.Button.LaunchSky">启动游戏</system:String>
    <system:String x:Key="Str.Button.Maintenance">维护</system:String>
    <system:String x:Key="Str.Button.Save">保存</system:String>

    <!-- Menu Items -->
    <system:String x:Key="Str.Menu.RepairInstallation">修复安装</system:String>
    <system:String x:Key="Str.Menu.VerifyFiles">验证游戏文件</system:String>
    <system:String x:Key="Str.Menu.InstallVCRedist">安装 VC Redist</system:String>
    <system:String x:Key="Str.Menu.UninstallTSM">卸载 TSM</system:String>

    <!-- Status Labels -->
    <system:String x:Key="Str.Status.TSM">TSM:</system:String>
    <system:String x:Key="Str.Status.SML">SML:</system:String>
    <system:String x:Key="Str.Status.VCRedist">VC Redist:</system:String>
    <system:String x:Key="Str.Status.Installed">已安装</system:String>
    <system:String x:Key="Str.Status.NotInstalled">未安装</system:String>

    <!-- Messages -->
    <system:String x:Key="Str.Message.UninstallConfirm">确定要卸载 TSM 吗？除 Sky 相关文件外的所有文件都将被删除。</system:String>
    <system:String x:Key="Str.Message.GameFolderNotFound">未找到游戏文件夹。请手动选择。</system:String>
    <system:String x:Key="Str.Message.UpdateAvailable">发现That Sky App新版本。是否现在安装？</system:String>
    <system:String x:Key="Str.Message.UpdateSuccess">TSM 更新成功</system:String>
    <system:String x:Key="Str.Message.InstallSuccess">TSM 安装成功</system:String>
    <system:String x:Key="Str.Message.UninstallSuccess">TSM 卸载成功</system:String>
    <system:String x:Key="Str.Message.DownloadingVCRedist">正在下载 VC Redist...</system:String>
    <system:String x:Key="Str.Message.InstallingVCRedist">正在安装 VC Redist...</system:String>
    <system:String x:Key="Str.Message.VCRedistSuccess">VC Redist 安装成功</system:String>
    <system:String x:Key="Str.Message.VCRedistFailed">VC Redist 安装失败 (错误: {0})</system:String>
    <system:String x:Key="Str.Message.VCRedistCancelled">用户取消了 VC Redist 安装</system:String>
    <system:String x:Key="Str.Message.CheckingUpdates">正在检查更新...</system:String>
    <system:String x:Key="Str.Message.DownloadFailed">下载失败: {0}</system:String>
    <system:String x:Key="Str.Message.UpdateFailed">更新失败: {0}</system:String>
    <system:String x:Key="Str.Message.InstallFailed">安装失败: {0}</system:String>
    <system:String x:Key="Str.Message.UninstallFailed">卸载失败: {0}</system:String>
    <system:String x:Key="Str.Message.VerifyFirst">是否要先通过Steam验证游戏文件？</system:String>
    <system:String x:Key="Str.Message.WaitForSteam">请等待Steam完成文件验证，然后点击"是"继续TSM修复。</system:String>
    <system:String x:Key="Str.Message.VerificationStarted">Steam文件验证已开始</system:String>

    <!-- Settings -->
    <system:String x:Key="Str.Settings.Title">设置</system:String>
    <system:String x:Key="Str.Settings.Language">语言</system:String>
    <system:String x:Key="Str.Settings.Save">保存</system:String>
    <system:String x:Key="Str.Button.Yes">是</system:String>
    <system:String x:Key="Str.Button.No">否</system:String>
</ResourceDictionary>